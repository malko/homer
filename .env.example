PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Public domain this instance advertises to peers for federation (e.g. via
# HTTPS through Caddy). Must be a real, resolvable hostname — docker-compose
# does NOT run shell command substitution, so something like "$(uname -n)"
# is used as a literal string, not evaluated, and will break peer federation.
# Leave unset to fall back to HOST_IP, or to no public URL at all.
#HOMER_DOMAIN=myhost.local

# Fallback public IP:PORT to advertise when HOMER_DOMAIN is not set.
#HOST_IP=192.168.1.10
